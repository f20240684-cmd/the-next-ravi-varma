# Copy this file to .env and fill in only the values you actually need.
# Never commit a real .env file. Never hard-code secrets in source code.

# Hugging Face Hub token. Only required if the base model / dataset you
# configure is gated (e.g. some SDXL variants) or you want to push
# checkpoints to the Hub.
HF_TOKEN=

# Optional: enables LLM-based prompt expansion (src/ravi_varma/generation/prompt_engine.py).
# If neither key is set, the prompt engine automatically falls back to the
# deterministic local template engine -- the app still works fully offline.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Where Hugging Face / torch should cache downloaded model weights.
# Defaults to ~/.cache/huggingface if left blank.
MODEL_CACHE_DIR=

# Optional: which LLM provider/model to use for prompt expansion when a key
# is present above. One of: "openai", "anthropic", "none".
PROMPT_EXPANSION_PROVIDER=none
PROMPT_EXPANSION_MODEL=
